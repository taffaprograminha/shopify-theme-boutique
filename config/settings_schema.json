    "name": "Social",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest URL"
      }
    ]
  },
  {
    "name": "Demo content",
    "settings": [
      {
        "type": "paragraph",
        "content": "Fills the rating bar and reviews section with sample data so the layout can be checked before a review app is connected. Turn this OFF before publishing the theme: showing invented reviews to shoppers is banned under the EU Omnibus Directive and the UK DMCC Act."
      },
      {
        "type": "checkbox",
        "id": "reviews_demo_mode",
        "label": "Show demo reviews",
        "default": false
      },
      {
        "type": "range",
        "id": "reviews_demo_rating",
        "label": "Demo score",
        "min": 30,
        "max": 50,
        "step": 1,
        "default": 46,
        "info": "Divided by 10, so 46 shows as 4.6"
      },
      {
        "type": "number",
        "id": "reviews_demo_count",
        "label": "Demo review count",
        "default": 1248
      }
    ]
  },
  {
    "name": "Search engines & sharing",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "32×32 recommended"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social sharing image",
        "info": "1200×630 recommended. Used when a page has no image of its own."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo for search results",
        "info": "Used in Organization structured data. Square, at least 112×112."
      }
    ]
  }
]
