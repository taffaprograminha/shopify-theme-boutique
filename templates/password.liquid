<section class="section password">
  <div class="container container--narrow" style="text-align:center;">
    <h1>{{ shop.name }}</h1>
    <p>{{ 'general.password_page.opening_soon' | t }}</p>
    {%- form 'storefront_password' -%}
      <label for="pw">{{ 'general.password_page.password_label' | t }}</label>
      <input type="password" name="password" id="pw">
      <button type="submit" class="btn btn--primary">{{ 'general.password_page.submit' | t }}</button>
      {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>
