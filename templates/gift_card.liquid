<section class="section gift-card">
  <div class="container container--narrow" style="text-align:center;">
    <h1>{{ shop.name }} {{ 'gift_cards.issued.card_name' | t }}</h1>
    <p>{{ 'gift_cards.issued.initial_value' | t }} : <strong>{{ gift_card.initial_value | money }}</strong></p>
    {%- if gift_card.expired -%}<p>{{ 'gift_cards.issued.expired' | t }}</p>{%- endif -%}
    <div class="gift-card__code">
      <code>{{ gift_card.code | format_code }}</code>
    </div>
    {%- if gift_card.qr_identifier -%}
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
    {%- endif -%}
    <p>{{ 'gift_cards.issued.balance' | t }} : {{ gift_card.balance | money }}</p>
  </div>
</section>
