<div class="section page-width" style="max-width: 460px">
  <h1 class="h3 text-center">{{ 'customer.reset_password.title' | t }}</h1>
  <p class="text-center" style="font-size:.8125rem;color:var(--color-muted)">
    {{ 'customer.reset_password.subtext' | t }}
  </p>

  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <div class="variant-group" style="margin:1rem 0">
      <label class="variant-group__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
      <input type="password" id="ResetPassword" name="customer[password]" class="newsletter__input" autocomplete="new-password" required>
    </div>
    <div class="variant-group" style="margin-bottom:1.5rem">
      <label class="variant-group__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
      <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" class="newsletter__input" autocomplete="new-password" required>
    </div>
    <button type="submit" class="btn btn--full btn--large">{{ 'customer.reset_password.submit' | t }}</button>
  {% endform %}
</div>
