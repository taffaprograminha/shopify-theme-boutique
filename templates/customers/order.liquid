<div class="section page-width">
  <div class="section-header section-header--inline">
    <h1 class="section-header__title h3">{{ 'customer.orders.order_number' | t }} {{ order.name }}</h1>
    <a href="{{ routes.account_url }}" class="section-header__link">{{ 'customer.account.return' | t }}</a>
  </div>

  <p style="font-size:.8125rem;color:var(--color-muted)">
    {{ order.created_at | date: '%d/%m/%Y' }} &middot;
    {{ order.financial_status_label }} &middot;
    {{ order.fulfillment_status_label }}
  </p>

  <table style="margin-top:1.5rem">
    <thead>
      <tr style="font-size:.75rem;text-transform:uppercase;letter-spacing:.08em">
        <th style="text-align:left;padding:8px 0">{{ 'customer.orders.product' | t }}</th>
        <th style="text-align:right;padding:8px 0">{{ 'customer.orders.price' | t }}</th>
        <th style="text-align:right;padding:8px 0">{{ 'customer.orders.quantity' | t }}</th>
        <th style="text-align:right;padding:8px 0">{{ 'customer.orders.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line in order.line_items -%}
        <tr style="border-top:1px solid var(--color-border);font-size:.8125rem">
          <td style="padding:12px 0">
            <a href="{{ line.product.url }}">{{ line.title }}</a>
          </td>
          <td style="padding:12px 0;text-align:right">{{ line.price | money }}</td>
          <td style="padding:12px 0;text-align:right">{{ line.quantity }}</td>
          <td style="padding:12px 0;text-align:right">{{ line.line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot style="font-size:.8125rem">
      <tr style="border-top:1px solid var(--color-border)">
        <td colspan="3" style="padding:10px 0;text-align:right">{{ 'customer.orders.subtotal' | t }}</td>
        <td style="padding:10px 0;text-align:right">{{ order.subtotal_price | money }}</td>
      </tr>
      {%- for shipping in order.shipping_methods -%}
        <tr>
          <td colspan="3" style="padding:4px 0;text-align:right">{{ 'customer.orders.shipping' | t }}</td>
          <td style="padding:4px 0;text-align:right">{{ shipping.price | money }}</td>
        </tr>
      {%- endfor -%}
      <tr style="font-weight:600">
        <td colspan="3" style="padding:10px 0;text-align:right">{{ 'customer.orders.total' | t }}</td>
        <td style="padding:10px 0;text-align:right">{{ order.total_price | money }}</td>
      </tr>
    </tfoot>
  </table>

  <div style="margin-top:2rem;font-size:.875rem;line-height:1.8">
    <h2 class="h5">{{ 'customer.addresses.title' | t }}</h2>
    {{ order.shipping_address | format_address }}
  </div>
</div>
