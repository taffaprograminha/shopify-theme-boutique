{%- comment -%}
  Translates option names and colour values for display.

  The catalogue was imported with English option data and inconsistent
  casing ("Black" and "black", "Navy Blue" and "Navy blue"), so matching is
  done on a lowercased key. Anything unmapped falls through unchanged, which
  keeps new products working without a theme edit.

  This is the single source for those dictionaries. The cart drawer is drawn
  in JavaScript from /cart.js, which returns the raw English data, so
  kind: 'map' emits the same dictionaries as JSON for layout/theme.liquid to
  hand to the script. Keeping two copies in step by hand would not survive.

  Params: value, kind (name|colour|map)
{%- endcomment -%}

{%- liquid
  assign name_from = 'color,colour,size,shoe size,top size,bottom size,style,material,length'
  assign name_to = 'Couleur,Couleur,Taille,Pointure,Taille haut,Taille bas,Style,Matière,Longueur'

  assign value_from = 'black,white,pink,khaki,blue,apricot,brown,yellow,red,purple,wine red,green,gray,grey,navy blue,navy,army green,coffee,sky blue,light blue,light gray,light grey,orange,dark green,royal blue,rose red,beige,cream,ivory,silver,gold,dark blue,light green,dark gray,dark grey,camel,burgundy,lotus color,khaki color,off white,brick red,orange red,multicolor,multicolour'
  assign value_to = 'Noir,Blanc,Rose,Kaki,Bleu,Abricot,Marron,Jaune,Rouge,Violet,Bordeaux,Vert,Gris,Gris,Bleu marine,Bleu marine,Vert armée,Café,Bleu ciel,Bleu clair,Gris clair,Gris clair,Orange,Vert foncé,Bleu roi,Rose vif,Beige,Crème,Ivoire,Argent,Doré,Bleu foncé,Vert clair,Gris foncé,Gris foncé,Camel,Bordeaux,Lotus,Kaki,Blanc cassé,Rouge brique,Rouge orangé,Multicolore,Multicolore'
-%}

{%- if kind == 'map' -%}
  {%- liquid
    assign nf = name_from | split: ','
    assign nt = name_to | split: ','
    assign vf = value_from | split: ','
    assign vt = value_to | split: ','
  -%}
  {"names":{
    {%- for k in nf -%}
      {{ k | json }}:{{ nt[forloop.index0] | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  },"values":{
    {%- for k in vf -%}
      {{ k | json }}:{{ vt[forloop.index0] | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }}
{%- else -%}
  {%- liquid
    assign key = value | downcase | strip

    if kind == 'name'
      assign from_list = name_from | split: ','
      assign to_list = name_to | split: ','
    else
      assign from_list = value_from | split: ','
      assign to_list = value_to | split: ','
    endif

    assign translated = ''
    for item in from_list
      if item == key
        assign translated = to_list[forloop.index0]
        break
      endif
    endfor
  -%}
  {%- if translated != blank -%}{{ translated }}{%- else -%}{{ value }}{%- endif -%}
{%- endif -%}
