{%- comment -%}
  Translates option names and colour values for display.

  The catalogue was imported with English option data and inconsistent
  casing ("Black" and "black", "Navy Blue" and "Navy blue"), so matching is
  done on a lowercased key. Anything unmapped falls through unchanged, which
  keeps new products working without a theme edit.

  This is the single source for those dictionaries. The cart drawer is drawn
  in JavaScript from /cart.js, which returns the raw English data, so
  kind: 'map' emits the same dictionaries as JSON for layout/theme.liquid to
  hand to the script. Keeping two copies in step by hand would not survive.

  Params: value, kind (name|colour|map)
{%- endcomment -%}

{%- liquid
  assign name_from = 'color,colour,size,shoe size,top size,bottom size,style,material,length'
  assign name_to = 'Couleur,Couleur,Taille,Pointure,Taille haut,Taille bas,Style,Matière,Longueur'

  assign value_from = 'black,white,pink,khaki,blue,apricot,brown,yellow,red,purple,wine red,green,gray,grey,navy blue,navy,army green,coffee,sky blue,light blue,light gray,light grey,orange,dark green,royal blue,rose red,beige,cream,ivory,silver,gold,dark blue,light green,dark gray,dark grey,camel,burgundy,lotus color,khaki color,off white,brick red,orange red,multicolor,multicolour,leopard print,leopard printleopard print,coffee color,olive green,champagne,light brown,dark brown,ginger yellow,bright blue,caramel,lemon yellow,rose color,rose pink,lake blue,denim blue,color blue,orange d11187,d11187 light khaki,d11187 camouflage green,d11187 colorful blue,dark blue d11179,big polka dot,dark blue stripes,light purple,sauce purple,silver gray,silver grey,high grade gray,black gray,brown set,blue and gray,deep maroon,deep red,dark red,mocha brown,light apricot,malachite green,milky white,cream white,light yellow,yellow brown,25508 ivory white,25508 black,25508 khaki color,25508 dark gray,25508 brown,25508 olive green,25508 pink,25508 burgundy,25508 yellow'
  assign value_to = 'Noir,Blanc,Rose,Kaki,Bleu,Abricot,Marron,Jaune,Rouge,Violet,Bordeaux,Vert,Gris,Gris,Bleu marine,Bleu marine,Vert armée,Café,Bleu ciel,Bleu clair,Gris clair,Gris clair,Orange,Vert foncé,Bleu roi,Rose vif,Beige,Crème,Ivoire,Argent,Doré,Bleu foncé,Vert clair,Gris foncé,Gris foncé,Camel,Bordeaux,Lotus,Kaki,Blanc cassé,Rouge brique,Rouge orangé,Multicolore,Multicolore,Léopard,Léopard,Café,Vert olive,Champagne,Marron clair,Marron foncé,Jaune gingembre,Bleu vif,Caramel,Jaune citron,Rose,Rose,Bleu lac,Bleu denim,Bleu,Orange,Kaki clair,Vert camouflage,Bleu,Bleu foncé,Grands pois,Rayures bleu foncé,Violet clair,Violet prune,Gris argent,Gris argent,Gris,Gris anthracite,Marron,Bleu et gris,Bordeaux foncé,Rouge foncé,Rouge foncé,Moka,Abricot clair,Vert malachite,Blanc laiteux,Blanc crème,Jaune clair,Brun doré,Blanc ivoire,Noir,Kaki,Gris foncé,Marron,Vert olive,Rose,Bordeaux,Jaune'
-%}

{%- if kind == 'map' -%}
  {%- liquid
    assign nf = name_from | split: ','
    assign nt = name_to | split: ','
    assign vf = value_from | split: ','
    assign vt = value_to | split: ','
  -%}
  {"names":{
    {%- for k in nf -%}
      {{ k | json }}:{{ nt[forloop.index0] | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  },"values":{
    {%- for k in vf -%}
      {{ k | json }}:{{ vt[forloop.index0] | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }}
{%- else -%}
  {%- liquid
    assign key = value | downcase | strip

    if kind == 'name'
      assign from_list = name_from | split: ','
      assign to_list = name_to | split: ','
    else
      assign from_list = value_from | split: ','
      assign to_list = value_to | split: ','
    endif

    assign translated = ''
    for item in from_list
      if item == key
        assign translated = to_list[forloop.index0]
        break
      endif
    endfor
  -%}
  {%- if translated != blank -%}{{ translated }}{%- else -%}{{ value }}{%- endif -%}
{%- endif -%}
