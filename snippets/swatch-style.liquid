{%- comment -%}
  Renders the inside of a colour swatch, choosing the best available source:
    1. swatch configured in Shopify admin (image, then colour)
    2. the featured image of the first variant using that value
    3. the value name as a CSS colour

  Step 3 alone is unreliable — "Light blue" and "Khaki color" are not CSS
  keywords and render as invisible chips.

  Params: value, option_index, product, size (px), label (bool)
{%- endcomment -%}

{%- liquid
  assign swatch_url = ''
  assign swatch_color = ''
  assign px = size | default: 120

  if value.swatch.image
    assign swatch_url = value.swatch.image | image_url: width: px
  elsif value.swatch.color
    assign swatch_color = value.swatch.color
  else
    for v in product.variants
      if v.options[option_index] == value and v.featured_media
        assign swatch_url = v.featured_media | image_url: width: px
        break
      endif
    endfor
    if swatch_url == blank
      comment
        No photo exists for this colour anywhere on the product, so the chip
        has to carry the meaning. CSS keywords alone were not enough: 19 of
        the 34 colours in this catalogue have no keyword at all ("Apricot",
        "Champagne", "Army green") and went grey, and some that do match are
        simply wrong, CSS "khaki" being a pale yellow rather than the cloth.
        Named values are resolved here first and the keyword is the fallback.
      endcomment
      assign key = value | downcase | strip
      assign hex_from = 'apricot,army green,navy blue,brick red,wine red,burgundy,champagne,coffee,coffee color,mocha brown,dark brown,yellow brown,khaki,khaki color,milky white,off white,lotus color,orange red,royal blue,camel,cream,beige,ivory,sky blue,light blue,dark green,rose red,light gray,light grey,dark gray,dark grey,gray,grey,white,black,silver,gold'
      assign hex_to = '#f2b880,#4b5320,#1b2a4a,#8c3a2b,#6e2639,#6e2639,#e8d5a9,#6b4a32,#6b4a32,#7b5e4b,#4a2f22,#a67b3b,#c3b091,#c3b091,#f7f3ec,#f3f0e8,#e6b7c1,#e04a24,#2b4fa2,#c19a6b,#fffdd0,#f5f5dc,#fffff0,#87ceeb,#add8e6,#1d4a2b,#c21e56,#d3d3d3,#d3d3d3,#a9a9a9,#a9a9a9,#808080,#808080,#ffffff,#111111,#c0c0c0,#d4af37'

      assign hf = hex_from | split: ','
      assign ht = hex_to | split: ','
      for name in hf
        if name == key
          assign swatch_color = ht[forloop.index0]
          break
        endif
      endfor

      if swatch_color == blank
        assign swatch_color = value | downcase | replace: ' ', '' | replace: '-', ''
      endif
    endif
  endif
-%}

{%- if swatch_url != blank -%}
  <img src="{{ swatch_url }}"
       alt="{{ value | escape }}"
       loading="lazy"
       width="{{ px | divided_by: 2 }}"
       height="{{ px | divided_by: 2 }}">
{%- else -%}
  {%- comment -%}
    Two declarations on purpose: an invalid colour keyword is dropped by the
    browser and the neutral one before it survives, so the chip is never blank.
  {%- endcomment -%}
  <span class="swatch-fill" style="background-color: #ddd9d2; background-color: {{ swatch_color }}"></span>
{%- endif -%}
{%- if label -%}<span class="visually-hidden">{{ value }}</span>{%- endif -%}
