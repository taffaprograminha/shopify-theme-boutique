<ul class="nav__list">
  {%- for link in linklists[menu].links -%}
    <li class="nav__item">
      <a href="{{ link.url }}" class="nav__link" {% if link.active %}aria-current="page"{% endif %}>
        {{ link.title }}
      </a>
      {%- if link.links.size > 0 -%}
        <div class="nav__dropdown">
          {%- for child in link.links -%}
            <a href="{{ child.url }}">{{ child.title }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
