{%- comment -%}
  Visual trust marks. Carrier and card-scheme logos are trademarks, so the
  merchant supplies those as an uploaded image; the built-in marks below are
  generic designs that ship with the theme.

  Params: badge (guarantee|delivery|secure|returns), image (uploaded logo), days
{%- endcomment -%}

{%- comment -%}
  Logo sources, in order: an image uploaded in theme settings, then a file
  bundled in assets/ (asset_file), then the built-in generic mark.
{%- endcomment -%}

{%- if image != blank -%}
  <img src="{{ image | image_url: width: 160 }}"
       alt="{{ alt | escape }}"
       class="trust-badge__logo"
       loading="lazy"
       width="{{ image.width }}"
       height="{{ image.height }}">

{%- elsif asset_file != blank -%}
  <img src="{{ asset_file | asset_url }}"
       alt="{{ alt | escape }}"
       class="trust-badge__logo"
       loading="lazy"
       width="160"
       height="124">

{%- else -%}
  {%- case badge -%}

    {%- when 'guarantee' -%}
      <svg class="trust-badge__mark" viewBox="0 0 48 48" role="img" aria-label="{{ alt | default: 'Money back guarantee' | escape }}">
        <circle cx="24" cy="24" r="23" fill="currentColor"/>
        <circle cx="24" cy="24" r="19.5" fill="none" stroke="#fff" stroke-width="1" stroke-dasharray="1.5 2"/>
        <text x="24" y="24" text-anchor="middle" font-size="15" font-weight="700" fill="#fff" font-family="Helvetica,Arial,sans-serif">{{ days | default: 30 }}</text>
        <text x="24" y="33" text-anchor="middle" font-size="6" letter-spacing="0.8" fill="#fff" font-family="Helvetica,Arial,sans-serif">JOURS</text>
      </svg>

    {%- when 'delivery' -%}
      <svg class="trust-badge__mark" viewBox="0 0 48 48" role="img" aria-label="{{ alt | default: 'Free delivery' | escape }}">
        <rect x="2" y="13" width="26" height="20" rx="2" fill="currentColor"/>
        <path d="M28 20h8l8 7v6H28z" fill="currentColor"/>
        <circle cx="12" cy="36" r="5" fill="currentColor"/>
        <circle cx="12" cy="36" r="2" fill="#fff"/>
        <circle cx="35" cy="36" r="5" fill="currentColor"/>
        <circle cx="35" cy="36" r="2" fill="#fff"/>
        <path d="M6 19h12M6 24h8" stroke="#fff" stroke-width="2" stroke-linecap="round"/>
      </svg>

    {%- when 'secure' -%}
      <svg class="trust-badge__mark" viewBox="0 0 48 48" role="img" aria-label="{{ alt | default: 'Secure checkout' | escape }}">
        <rect x="3" y="11" width="42" height="28" rx="3" fill="currentColor"/>
        <rect x="3" y="17" width="42" height="6" fill="#fff"/>
        <rect x="8" y="29" width="13" height="4" rx="1" fill="#fff"/>
        <rect x="26" y="27" width="15" height="9" rx="1.5" fill="#fff"/>
        <path d="M29.5 27v-2.5a4 4 0 0 1 8 0V27" fill="none" stroke="#fff" stroke-width="2"/>
      </svg>

    {%- when 'returns' -%}
      <svg class="trust-badge__mark" viewBox="0 0 48 48" role="img" aria-label="{{ alt | default: 'Easy returns' | escape }}">
        <circle cx="24" cy="24" r="23" fill="currentColor"/>
        <path d="M15 24a9 9 0 1 0 3-6.7L15 20" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"/>
        <path d="M14 14v7h7" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>

  {%- endcase -%}
{%- endif -%}
