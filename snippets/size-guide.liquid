<button type="button" class="size-guide__trigger" data-size-guide-open>
  {% render 'icons', icon: 'ruler' %}
  {{ 'products.product.size_guide' | t }}
</button>

<div class="size-guide" data-size-guide aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'products.product.size_guide' | t }}">
  <div class="size-guide__panel">
    <div class="size-guide__head">
      <h2 class="size-guide__title">{{ 'products.product.size_guide' | t }}</h2>
      <button type="button" class="header__action" data-size-guide-close aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icons', icon: 'close' %}
      </button>
    </div>

    <div class="size-guide__body">
      {%- if block.settings.intro != blank -%}
        <p class="size-guide__intro">{{ block.settings.intro }}</p>
      {%- endif -%}

      <div class="size-guide__scroll">
        <table class="size-table">
          <thead>
            <tr>
              <th>{{ 'products.product.size_fr' | t }}</th>
              <th>{{ 'products.product.size_letter' | t }}</th>
              <th>UK</th>
              <th>US</th>
              <th>IT</th>
              <th>{{ 'products.product.bust' | t }}</th>
              <th>{{ 'products.product.waist' | t }}</th>
              <th>{{ 'products.product.hips' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {%- comment -%}
              Bust/waist/hips are body measurements in cm, not garment
              measurements — the standard French ready-to-wear grid.
            {%- endcomment -%}
            {%- assign rows = '34|XS|6|2|38|80|62|86,36|S|8|4|40|84|66|90,38|M|10|6|42|88|70|94,40|L|12|8|44|92|74|98,42|XL|14|10|46|96|78|102,44|2XL|16|12|48|101|83|107,46|3XL|18|14|50|106|88|112,48|4XL|20|16|52|111|93|117,50|5XL|22|18|54|116|98|122' | split: ',' -%}
            {%- for row in rows -%}
              {%- assign c = row | split: '|' -%}
              <tr>
                <td><strong>{{ c[0] }}</strong></td>
                <td>{{ c[1] }}</td>
                <td>{{ c[2] }}</td>
                <td>{{ c[3] }}</td>
                <td>{{ c[4] }}</td>
                <td>{{ c[5] }}</td>
                <td>{{ c[6] }}</td>
                <td>{{ c[7] }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      {%- if block.settings.shoe_table -%}
        <h3 class="size-guide__subtitle">{{ 'products.product.shoe_sizes' | t }}</h3>
        <div class="size-guide__scroll">
          <table class="size-table">
            <thead>
              <tr>
                <th>{{ 'products.product.size_fr' | t }}</th>
                <th>UK</th>
                <th>US</th>
                <th>{{ 'products.product.foot_length' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- assign shoes = '35|2.5|5|22.5,36|3.5|6|23,37|4|6.5|23.5,38|5|7.5|24.5,39|6|8|25,40|6.5|8.5|25.5,41|7.5|9.5|26.5,42|8|10|27,43|9|11|28' | split: ',' -%}
              {%- for row in shoes -%}
                {%- assign c = row | split: '|' -%}
                <tr>
                  <td><strong>{{ c[0] }}</strong></td>
                  <td>{{ c[1] }}</td>
                  <td>{{ c[2] }}</td>
                  <td>{{ c[3] }} cm</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}

      {%- if block.settings.note != blank -%}
        <p class="size-guide__note">{{ block.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</div>
