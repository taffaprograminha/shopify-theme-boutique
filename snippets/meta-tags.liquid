{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_desc = page_description | default: shop.description | default: shop.name
  assign og_image = null

  if template.name == 'product' and product.featured_image
    assign og_image = product.featured_image
  elsif template.name == 'article' and article.image
    assign og_image = article.image
  elsif template.name == 'collection' and collection.image
    assign og_image = collection.image
  elsif settings.share_image
    assign og_image = settings.share_image
  endif
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">

{%- if template.name == 'product' -%}
  <meta property="og:type" content="product">
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- elsif template.name == 'article' -%}
  <meta property="og:type" content="article">
{%- else -%}
  <meta property="og:type" content="website">
{%- endif -%}

{%- comment -%}
  image_url returns a root-relative path, so the origin must be prepended or
  social crawlers reject the image.
{%- endcomment -%}
{%- if og_image -%}
  <meta property="og:image" content="{{ og_image | image_url: width: 1200 | prepend: request.origin }}">
  <meta property="og:image:secure_url" content="{{ og_image | image_url: width: 1200 | prepend: request.origin }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ og_image.alt | default: og_title | escape }}">
{%- endif -%}

<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="{{ og_image | image_url: width: 1200 | prepend: request.origin }}">
{%- endif -%}

{%- comment -%}
  Filtered, sorted and paginated collection views are near-duplicates of the
  canonical collection page, so they are kept out of the index.
{%- endcomment -%}
{%- liquid
  assign is_duplicate = false
  if template.name == 'collection' and current_tags
    assign is_duplicate = true
  endif
  if request.path contains '/search' and search.terms == blank
    assign is_duplicate = true
  endif
  unless request.page_type == 'index'
    if collection.sort_by != blank and collection.sort_by != collection.default_sort_by
      assign is_duplicate = true
    endif
  endunless
-%}
{%- if is_duplicate -%}
  <meta name="robots" content="noindex, follow">
{%- endif -%}
