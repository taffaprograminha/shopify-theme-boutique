{%- comment -%}
  Single source of truth for cart line markup. The drawer renders its updates
  client-side, so global.js mirrors this structure — keep the two in step.
{%- endcomment -%}
<div class="cart-item"{% if wide %} style="grid-template-columns: 96px 1fr"{% endif %}>
  <div class="cart-item__img">
    <a href="{{ item.url }}">
      {%- if item.image -%}
        {%- assign size = 160 -%}
        {%- if wide -%}{%- assign size = 200 -%}{%- endif -%}
        <img src="{{ item.image | image_url: width: size }}"
             alt="{{ item.image.alt | escape }}"
             loading="lazy"
             width="{% if wide %}96{% else %}72{% endif %}"
             height="{% if wide %}96{% else %}72{% endif %}">
      {%- endif -%}
    </a>
  </div>

  <div class="cart-item__info">
    <a href="{{ item.url }}" class="cart-item__title">{{ item.product_title | default: item.product.title }}</a>

    {%- unless item.product_has_only_default_variant or item.product.has_only_default_variant -%}
      {%- comment -%}
        Built from options rather than variant.title, which is the raw
        "White / 36 S" string, and so it matches what the drawer prints.
      {%- endcomment -%}
      <span class="cart-item__variant">
        {%- for opt in item.options_with_values -%}
          {%- unless opt.value == 'Default Title' -%}
            {%- render 'option-label', value: opt.name, kind: 'name' -%}:
            {% render 'option-label', value: opt.value, kind: 'colour' -%}
            {%- unless forloop.last %} &middot; {% endunless -%}
          {%- endunless -%}
        {%- endfor -%}
      </span>
    {%- endunless -%}

    <div class="price">
      {%- if item.original_line_price > item.final_line_price -%}
        <s class="price__compare">{{ item.original_line_price | money }}</s>
        <span class="price__sale">{{ item.final_line_price | money }}</span>
      {%- else -%}
        <span class="price__regular">{{ item.final_line_price | money }}</span>
      {%- endif -%}
    </div>

    {%- comment -%}
      Naming the rule that fired beats a silent strikethrough: the shopper can
      see it was "2+2" and not a price that moved on its own.
    {%- endcomment -%}
    {%- for alloc in item.line_level_discount_allocations -%}
      <span class="cart-item__discount">{{ alloc.discount_application.title }}</span>
    {%- endfor -%}

    <div class="cart-item__foot">
      {%- if form_input -%}
        {% render 'quantity-input', name: 'updates[', key: item.key, value: item.quantity, min: 0 %}
        <a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'general.cart.remove' | t }}</a>
      {%- else -%}
        {% render 'quantity-input', ajax_key: item.key, value: item.quantity, min: 0 %}
        <button type="button" class="cart-item__remove" data-cart-remove data-key="{{ item.key }}">
          {{ 'general.cart.remove' | t }}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>
