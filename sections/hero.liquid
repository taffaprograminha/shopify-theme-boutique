<section class="hero hero--{{ section.settings.height }} hero--{{ section.settings.align }}" {{ section.shopify_attributes }}>
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}"
           srcset="{{ section.settings.image | image_url: width: 800 }} 800w,
                   {{ section.settings.image | image_url: width: 1600 }} 1600w,
                   {{ section.settings.image | image_url: width: 2400 }} 2400w"
           sizes="100vw"
           alt="{{ section.settings.image.alt | escape }}"
           width="{{ section.settings.image.width }}"
           height="{{ section.settings.image.height }}"
           fetchpriority="high" style="object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%">
    {%- elsif section.settings.image_asset != blank -%}
      {%- comment -%}
        A theme asset, for an image shipped with the theme rather than picked
        from the Files library. Same approach as the carrier logo. The picker
        above still wins, so uploading through the editor overrides this.
      {%- endcomment -%}
      {%- comment -%}
        No width/height: Liquid cannot read a theme asset's dimensions, and
        .hero__media img is absolutely positioned at inset:0 with object-fit,
        so intrinsic size never affects layout and no shift is possible.
      {%- endcomment -%}
      {% # theme-check-disable ImgWidthAndHeight %}
      {%- comment -%}
        No 2400w candidate: Shopify never upscales, so asset_img_url '2400x'
        returns whatever the file actually is. Advertising a width the source
        cannot deliver makes the browser think it has enough pixels when it
        does not. Cap the srcset at a width the file can honestly meet.
      {%- endcomment -%}
      <img src="{{ section.settings.image_asset | asset_img_url: '1600x' }}"
           srcset="{{ section.settings.image_asset | asset_img_url: '800x' }} 800w,
                   {{ section.settings.image_asset | asset_img_url: '1600x' }} 1600w"
           sizes="100vw"
           alt="{{ section.settings.image_asset_alt | escape }}"
           fetchpriority="high" style="object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%">
      {% # theme-check-enable ImgWidthAndHeight %}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  {%- if section.settings.overlay_opacity > 0 -%}
    <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  {%- endif -%}

  {%- comment -%}
    The hero can sit on any template, so it must not emit a second <h1> on
    pages that already have one (product, article, collection).
  {%- endcomment -%}
  {%- liquid
    assign heading_tag = section.settings.heading_tag
    if heading_tag == 'auto'
      if request.page_type == 'index'
        assign heading_tag = 'h1'
      else
        assign heading_tag = 'p'
      endif
    endif
  -%}
  <div class="hero__content" style="color: {{ section.settings.text_color }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="hero__heading">{{ section.settings.heading }}</{{ heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subtext != blank -%}
      <p class="hero__subtext">{{ section.settings.subtext }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn--white btn--large">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Background image from theme assets",
      "info": "Filename in assets/, e.g. hero-boutique.jpg. Only used when no image is picked above."
    },
    { "type": "text", "id": "image_asset_alt", "label": "Alt text for the theme asset image" },
    {
      "type": "range",
      "id": "focal_x",
      "label": "Focal point (horizontal)",
      "info": "Which part of the image stays visible when it is cropped, typically on phones. 50 is the centre.",
      "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "label": "Focal point (vertical)",
      "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Content alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 25 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Jusqu'à -80%" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading level",
      "info": "Auto uses H1 on the home page only, so other pages keep a single H1.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "p", "label": "Plain text" }
      ],
      "default": "auto"
    },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Pas d'adieu. Pas encore." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Découvrir la collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
