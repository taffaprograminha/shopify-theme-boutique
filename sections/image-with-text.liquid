<section class="image-text {% if section.settings.layout == 'image-right' %}image-text--right{% endif %} {% if section.settings.image_fit == 'contain' %}image-text--contain{% endif %}" style="--image-text-bg: {{ section.settings.bg }}" {{ section.shopify_attributes }}>
  <div class="image-text__media">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1400 }}"
           alt="{{ section.settings.image.alt | escape }}"
           loading="lazy"
           width="{{ section.settings.image.width }}"
           height="{{ section.settings.image.height }}" style="object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%">
    {%- elsif section.settings.image_asset != blank -%}
      {%- comment -%}
        A theme asset, for an image shipped with the theme rather than picked
        from the Files library. The picker above still wins. No width/height:
        Liquid cannot read an asset's dimensions, and .image-text__media img
        is absolutely positioned with object-fit, so no layout shift.
      {%- endcomment -%}
      {% # theme-check-disable ImgWidthAndHeight %}
      <img src="{{ section.settings.image_asset | asset_img_url: '1400x' }}"
           srcset="{{ section.settings.image_asset | asset_img_url: '700x' }} 700w,
                   {{ section.settings.image_asset | asset_img_url: '1400x' }} 1400w"
           sizes="(min-width: 900px) 50vw, 100vw"
           alt="{{ section.settings.image_asset_alt | escape }}"
           loading="lazy" style="object-position: {{ section.settings.focal_x }}% {{ section.settings.focal_y }}%">
      {% # theme-check-enable ImgWidthAndHeight %}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
  </div>

  <div class="image-text__content" style="background: {{ section.settings.bg }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="story__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="h3">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="rte" style="font-size: .9375rem">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div style="margin-top: 1.5rem">
        <a href="{{ section.settings.button_link }}" class="btn btn--outline">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Image from theme assets",
      "info": "Filename in assets/, e.g. story-boutique.jpg. Only used when no image is picked above."
    },
    { "type": "text", "id": "image_asset_alt", "label": "Alt text for the theme asset image" },
    {
      "type": "range",
      "id": "focal_x",
      "label": "Focal point (horizontal)",
      "info": "Which part of the image stays visible once it is cropped to the column. 50 is the centre.",
      "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50
    },
    {
      "type": "range",
      "id": "focal_y",
      "label": "Focal point (vertical)",
      "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Fill the column (may crop edges)" },
        { "value": "contain", "label": "Show the whole image (may leave bands)" }
      ],
      "default": "cover",
      "info": "Use Show the whole image for portraits and product shots where nothing should be cropped away."
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "image-left", "label": "Image left" },
        { "value": "image-right", "label": "Image right" }
      ],
      "default": "image-left"
    },
    { "type": "color", "id": "bg", "label": "Content background", "default": "#f5f2ec" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notre histoire" },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Quelques mots sur votre marque.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
