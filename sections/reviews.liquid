{%- comment -%}
  Customer reviews.

  Real reviews come from a review app through product metafields. Demo cards
  fill the section while none exist, gated behind settings.reviews_demo_mode
  so a draft theme can be reviewed. That switch must be off once the store
  opens: invented reviews shown to shoppers are banned under the EU Omnibus
  Directive and the UK DMCC Act.
{%- endcomment -%}

{%- liquid
  assign reviews = product.metafields.reviews.reviews.value
  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count

  assign has_reviews = false
  if reviews != blank and reviews.size > 0
    assign has_reviews = true
  endif

  assign is_sample = false
  unless has_reviews
    if settings.reviews_demo_mode or request.design_mode
      assign is_sample = true
    endif
  endunless
-%}

{%- if has_reviews or is_sample -%}
  <section class="section reviews" style="background: {{ section.settings.background }}" {{ section.shopify_attributes }}>
    <div class="page-width">
      <div class="reviews__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title h3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="reviews__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}

        <div class="reviews__score">
          {% render 'rating-bar', scope: 'product', align: 'center' %}
        </div>

        {%- if is_sample and settings.reviews_demo_badge -%}
          <p class="reviews__sample-note">{{ 'products.rating.editor_only' | t }}</p>
        {%- endif -%}
      </div>

      <div class="reviews__grid">
        {%- if has_reviews -%}
          {%- for review in reviews limit: section.settings.reviews_to_show -%}
            <article class="review-card">
              <div class="review-card__head">
                <span class="review-card__author">{{ review.author }}</span>
                <span class="review-card__date">{{ review.created_at | date: format: 'abbreviated_date' }}</span>
              </div>
              <div class="review-card__stars" role="img" aria-label="{{ review.rating }}/5">
                {%- for i in (1..5) -%}
                  {%- if i <= review.rating -%}{% render 'icons', icon: 'star' %}{%- endif -%}
                {%- endfor -%}
              </div>
              <p class="review-card__body">{{ review.body }}</p>
              {%- if review.verified -%}
                <span class="review-card__verified">
                  {% render 'icons', icon: 'check' %}{{ 'products.rating.verified' | t }}
                </span>
              {%- endif -%}
            </article>
          {%- endfor -%}

        {%- else -%}
          {%- comment -%}
            Placeholder copy is obviously generic and tagged as a sample, so
            it can never be mistaken for a real customer voice.
          {%- endcomment -%}
          {%- for i in (1..6) limit: section.settings.reviews_to_show -%}
            {%- if forloop.index0 == 0 -%}
              {%- assign demo_author = "Émilie W." -%}
              {%- assign demo_date = "il y a 2 heures" -%}
              {%- assign demo_stars = 5 -%}
              {%- capture demo_body -%}La qualité des vêtements est remarquable. J&rsquo;ai commandé une robe et elle tombe parfaitement, le tissu est confortable et élégant.{%- endcapture -%}
            {%- endif -%}
            {%- if forloop.index0 == 1 -%}
              {%- assign demo_author = "Sarah M." -%}
              {%- assign demo_date = "il y a 5 heures" -%}
              {%- assign demo_stars = 5 -%}
              {%- capture demo_body -%}Je suis absolument ravie de ma commande. Les pièces correspondent exactement aux photos et les tailles sont justes.{%- endcapture -%}
            {%- endif -%}
            {%- if forloop.index0 == 2 -%}
              {%- assign demo_author = "Charlotte H." -%}
              {%- assign demo_date = "il y a 1 jour" -%}
              {%- assign demo_stars = 4 -%}
              {%- capture demo_body -%}J&rsquo;adore le style de la boutique. Les pièces sont modernes et très flatteuses. On me complimente à chaque fois.{%- endcapture -%}
            {%- endif -%}
            {%- if forloop.index0 == 3 -%}
              {%- assign demo_author = "Olivia B." -%}
              {%- assign demo_date = "il y a 3 jours" -%}
              {%- assign demo_stars = 5 -%}
              {%- capture demo_body -%}Excellent rapport qualité-prix. J&rsquo;ai commandé plusieurs fois et je suis toujours satisfaite. Livraison rapide.{%- endcapture -%}
            {%- endif -%}
            {%- if forloop.index0 == 4 -%}
              {%- assign demo_author = "Camille R." -%}
              {%- assign demo_date = "il y a 4 jours" -%}
              {%- assign demo_stars = 5 -%}
              {%- capture demo_body -%}Le manteau est encore plus beau en vrai. Coupe impeccable et finitions soignées.{%- endcapture -%}
            {%- endif -%}
            {%- if forloop.index0 == 5 -%}
              {%- assign demo_author = "Manon L." -%}
              {%- assign demo_date = "il y a 1 semaine" -%}
              {%- assign demo_stars = 4 -%}
              {%- capture demo_body -%}Très bonne expérience. Le colis est arrivé bien emballé et le suivi était clair du début à la fin.{%- endcapture -%}
            {%- endif -%}
            <article class="review-card{% if settings.reviews_demo_badge %} review-card--sample{% endif %}">
              <div class="review-card__head">
                <span class="review-card__author">{{ demo_author }}</span>
                <span class="review-card__date">{{ demo_date }}</span>
              </div>
              <div class="review-card__stars" role="img" aria-label="{{ demo_stars }}/5">
                {%- for s in (1..demo_stars) -%}{% render 'icons', icon: 'star' %}{%- endfor -%}
              </div>
              <p class="review-card__body">{{ demo_body }}</p>
              <span class="review-card__verified">
                {% render 'icons', icon: 'check' %}{{ 'products.rating.verified' | t }}
              </span>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reviews come from your review app (Judge.me, Loox, Okendo, Shopify Product Reviews). Until one is connected the section shows sample cards in this editor only and stays hidden on the live store."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Votre satisfaction est notre réussite" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Ce que disent nos clientes" },
    { "type": "range", "id": "reviews_to_show", "label": "Reviews to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
