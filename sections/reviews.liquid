{%- comment -%}
  Customer reviews.

  Real reviews come from a review app through product metafields. When none
  exist the section renders sample cards inside the theme editor only
  (request.design_mode), so the layout can be designed without fabricated
  testimonials ever reaching a shopper.
{%- endcomment -%}

{%- liquid
  assign reviews = product.metafields.reviews.reviews.value
  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count

  assign has_reviews = false
  if reviews != blank and reviews.size > 0
    assign has_reviews = true
  endif

  assign is_sample = false
  unless has_reviews
    if request.design_mode
      assign is_sample = true
    endif
  endunless
-%}

{%- if has_reviews or is_sample -%}
  <section class="section reviews" style="background: {{ section.settings.background }}" {{ section.shopify_attributes }}>
    <div class="page-width">
      <div class="reviews__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-header__title h3">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subtext != blank -%}
          <p class="reviews__subtext">{{ section.settings.subtext }}</p>
        {%- endif -%}

        <div class="reviews__score">
          {% render 'rating-bar', scope: 'product', align: 'center' %}
        </div>

        {%- if is_sample -%}
          <p class="reviews__sample-note">{{ 'products.rating.editor_only' | t }}</p>
        {%- endif -%}
      </div>

      <div class="reviews__grid">
        {%- if has_reviews -%}
          {%- for review in reviews limit: section.settings.reviews_to_show -%}
            <article class="review-card">
              <div class="review-card__head">
                <span class="review-card__author">{{ review.author }}</span>
                <span class="review-card__date">{{ review.created_at | date: format: 'abbreviated_date' }}</span>
              </div>
              <div class="review-card__stars" role="img" aria-label="{{ review.rating }}/5">
                {%- for i in (1..5) -%}
                  {%- if i <= review.rating -%}{% render 'icons', icon: 'star' %}{%- endif -%}
                {%- endfor -%}
              </div>
              <p class="review-card__body">{{ review.body }}</p>
              {%- if review.verified -%}
                <span class="review-card__verified">
                  {% render 'icons', icon: 'check' %}{{ 'products.rating.verified' | t }}
                </span>
              {%- endif -%}
            </article>
          {%- endfor -%}

        {%- else -%}
          {%- comment -%}
            Placeholder copy is obviously generic and tagged as a sample, so
            it can never be mistaken for a real customer voice.
          {%- endcomment -%}
          {%- assign samples = 'A,B,C,D' | split: ',' -%}
          {%- for s in samples -%}
            <article class="review-card review-card--sample">
              <div class="review-card__head">
                <span class="review-card__author">{{ 'products.rating.sample_author' | t }} {{ s }}</span>
                <span class="review-card__date">{{ 'products.rating.sample_date' | t }}</span>
              </div>
              <div class="review-card__stars" role="img" aria-label="5/5">
                {%- for i in (1..5) -%}{% render 'icons', icon: 'star' %}{%- endfor -%}
              </div>
              <p class="review-card__body">{{ 'products.rating.sample_body' | t }}</p>
              <span class="review-card__verified">
                {% render 'icons', icon: 'check' %}{{ 'products.rating.verified' | t }}
              </span>
            </article>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reviews come from your review app (Judge.me, Loox, Okendo, Shopify Product Reviews). Until one is connected the section shows sample cards in this editor only and stays hidden on the live store."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Votre satisfaction est notre réussite" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Ce que disent nos clientes" },
    { "type": "range", "id": "reviews_to_show", "label": "Reviews to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "color", "id": "background", "label": "Background", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Reviews" }]
}
{% endschema %}
