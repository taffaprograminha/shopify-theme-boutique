<footer class="footer"
        style="--footer-bg: {{ section.settings.background }};
               --footer-text: {{ section.settings.text_color }};
               --footer-muted: {{ section.settings.text_color | color_modify: 'alpha', 0.65 }};
               --footer-rule: {{ section.settings.text_color | color_modify: 'alpha', 0.18 }}"
        {{ section.shopify_attributes }}>
  <div class="page-width">

    <div class="footer__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}

        {%- when 'menu' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="footer__heading">{{ block.settings.title }}</h3>
            {%- endif -%}
            <ul class="footer__links">
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>

        {%- when 'text' -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <h3 class="footer__heading">{{ block.settings.title }}</h3>
            {%- endif -%}
            <div class="footer__text rte">{{ block.settings.text }}</div>
          </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="footer__newsletter">
        {%- if section.settings.newsletter_title != blank -%}
          <h3 class="footer__heading">{{ section.settings.newsletter_title }}</h3>
        {%- endif -%}

        {% form 'customer' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.email' | t }}</label>
          <div class="footer__newsletter-row">
            <input type="email"
                   id="FooterEmail"
                   name="contact[email]"
                   class="footer__newsletter-input"
                   placeholder="{{ 'general.newsletter.email' | t }}"
                   required>
            <button type="submit" class="footer__newsletter-btn">
              {{ 'general.newsletter.button' | t }}
              {% render 'icons', icon: 'arrow-right' %}
            </button>
          </div>
          {%- if form.posted_successfully? -%}
            <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="form-error">{{ form.errors.messages.form }}</p>
          {%- endif -%}
        {% endform %}

        {%- if section.settings.newsletter_note != blank -%}
          <p class="footer__newsletter-note">{{ section.settings.newsletter_note }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="footer__bottom">
      <div class="footer__bottom-left">
        {%- if section.settings.show_localization -%}
          {% render 'localization' %}
        {%- endif -%}
      </div>

      <p class="footer__copy">
        &copy; {{ shop.name }} {{ 'now' | date: '%Y' }}
      </p>

      <div class="footer__bottom-right">
        {%- if section.settings.show_payment_icons -%}
          {% render 'payment-icons', align: 'right' %}
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.show_social -%}
      <div class="footer__social">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
        {%- endif -%}
        {%- if settings.social_facebook != blank -%}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>
        {%- endif -%}
        {%- if settings.social_pinterest != blank -%}
          <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener">Pinterest</a>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "color", "id": "background", "label": "Background", "default": "#0a0a0a" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#ffffff" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "Newsletter title", "default": "Newsletter" },
    { "type": "text", "id": "newsletter_note", "label": "Newsletter note" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_localization", "label": "Show country picker", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": false }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Informations" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Contact" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "text" },
        { "type": "menu" },
        { "type": "text" },
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
