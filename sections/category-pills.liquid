{%- liquid
  assign has_items = false
  for block in section.blocks
    assign coll = collections[block.settings.collection]
    assign label = block.settings.label | default: coll.title
    assign url = block.settings.link | default: coll.url
    if label != blank and url != blank
      assign has_items = true
      break
    endif
  endfor
-%}

{%- if has_items -%}
  <nav class="category-pills" aria-label="{{ section.settings.heading | default: 'Categories' | escape }}" {{ section.shopify_attributes }}>
    <div class="category-pills__scroll">
      {%- for block in section.blocks -%}
        {%- liquid
          assign coll = collections[block.settings.collection]
          assign label = block.settings.label | default: coll.title
          assign url = block.settings.link | default: coll.url
        -%}
        {%- if label != blank and url != blank -%}
          <a href="{{ url }}"
             class="category-pills__item"
             {% if collection.handle == coll.handle %}aria-current="page"{% endif %}
             {{ block.shopify_attributes }}>
            {{ label }}
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </nav>
{%- endif -%}

{% schema %}
{
  "name": "Category pills",
  "tag": "section",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "heading", "label": "Accessible label", "default": "Categories" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to collection title" },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Overrides the collection link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category pills",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
