<section class="story" {{ section.shopify_attributes }}>
  <div class="story__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="story__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="story__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="story__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.show_tiers and settings.volume_bar_enabled -%}
      <div class="tier-callout">
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign value = settings.volume_tier_1_value
                assign label = settings.volume_tier_1_label
              when 2
                assign value = settings.volume_tier_2_value
                assign label = settings.volume_tier_2_label
              else
                assign value = settings.volume_tier_3_value
                assign label = settings.volume_tier_3_label
            endcase
          -%}
          {%- if value != blank -%}
            <div class="tier-callout__item">
              <div class="tier-callout__value">{{ value }}</div>
              <div class="tier-callout__label">{{ label }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.tier_note != blank -%}
        <p class="tier-callout__note">{{ section.settings.tier_note }}</p>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="story__cta">
        <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn--large">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Story",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This is what twenty-five years looks like." },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Racontez l\u2019histoire de votre boutique. Qui l\u2019a lancée, pourquoi elle existe et ce qu\u2019elle représente pour vos clientes.</p>"
    },
    { "type": "header", "content": "Discount tiers" },
    { "type": "checkbox", "id": "show_tiers", "label": "Show volume discount tiers", "default": true },
    {
      "type": "text",
      "id": "tier_note",
      "label": "Tier note",
      "default": "Les remises sont appliquées automatiquement au paiement et se cumulent sur toutes les collections."
    },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Story" }]
}
{% endschema %}
